  <style>
    :root {
      --bg: #0b0f19;
      --card-bg: #151d30;
      --card-hover: #1c2742;
      --accent: #38bdf8;
      --accent-glow: rgba(56, 189, 248, 0.15);
      --accent-hover: #0284c7;
      --text: #f8fafc;
      --muted: #94a3b8;
      --border: #24314d;
      --tag-bg: #0f172a;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      padding: 40px 20px;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
    }

    /* Header */
    header {
      border-bottom: 1px solid var(--border);
      padding-bottom: 35px;
      margin-bottom: 40px;
    }

    .header-main {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 20px;
    }

    h1 {
      font-size: 2.75rem;
      color: #fff;
      letter-spacing: -0.02em;
    }

    .subtitle {
      font-size: 1.25rem;
      color: var(--accent);
      font-weight: 600;
      margin-top: 4px;
      margin-bottom: 12px;
    }

    .location {
      color: var(--muted);
      font-size: 0.95rem;
      margin-bottom: 18px;
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .bio {
      color: var(--muted);
      max-width: 820px;
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .contact-links {
      margin-top: 25px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      padding: 10px 18px;
      background: var(--card-bg);
      color: var(--accent);
      border: 1px solid var(--border);
      border-radius: 8px;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .btn:hover {
      border-color: var(--accent);
      background: #1e2b47;
      transform: translateY(-2px);
    }

    .btn-primary {
      background: var(--accent);
      color: #0f172a;
      border: 1px solid var(--accent);
    }

    .btn-primary:hover {
      background: var(--accent-hover);
      color: #fff;
    }

    /* Sections */
    section {
      margin-bottom: 50px;
    }

    h2 {
      font-size: 1.6rem;
      color: #fff;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    h2::before {
      content: "";
      display: inline-block;
      width: 4px;
      height: 1.4rem;
      background-color: var(--accent);
      border-radius: 2px;
    }

    /* Grids & Cards */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .card:hover {
      border-color: rgba(56, 189, 248, 0.4);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 10px;
    }

    .card h3 {
      font-size: 1.2rem;
      color: #fff;
      line-height: 1.4;
    }

    .company {
      color: var(--accent);
      font-size: 0.95rem;
      font-weight: 500;
      margin-bottom: 8px;
    }

    .date {
      color: var(--muted);
      font-size: 0.85rem;
      font-weight: 500;
      white-space: nowrap;
    }

    .card p, .card ul {
      color: var(--muted);
      font-size: 0.95rem;
    }

    .card ul {
      list-style-type: disc;
      padding-left: 20px;
      margin-top: 10px;
    }

    .card ul li {
      margin-bottom: 8px;
    }

    /* Project Specific Styling */
    .project-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .project-meta {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    .project-tag {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.78rem;
      color: var(--accent);
      background: var(--accent-glow);
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid rgba(56, 189, 248, 0.2);
    }

    /* Badges & General Tags */
    .cert-badge {
      display: inline-block;
      background: var(--accent-glow);
      color: var(--accent);
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 12px;
    }

    .tag-container {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tag {
      background: var(--tag-bg);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 0.88rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    /* Footer */
    footer {
      text-align: center;
      padding-top: 30px;
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.85rem;
    }
  </style>
</head>
